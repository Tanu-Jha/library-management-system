# server/.env

# Server Configuration
PORT=9990
CLIENT_URL=http://localhost:3000

# Database
# Replace with your actual MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/library_db

# Authentication
# You can generate a random string for the secret
JWT_SECRET=your_secure_jwt_secret_key_2024

# Google OAuth (Optional - required only for Google Login)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com